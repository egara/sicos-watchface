<WatchFace width="450" height="450" clipShape="CIRCLE">
    <Metadata key="CLOCK_TYPE" value="DIGITAL" />
    <Metadata key="PREVIEW_TIME" value="10:09:30" />

    <Scene backgroundColor="#ff282828">

        <!-- ============================================================ -->
        <!-- TOP METRICS ROW (Heart Rate, Steps, Battery)                 -->
        <!-- Fades out in Ambient / AOD mode                              -->
        <!-- ============================================================ -->
        <Group name="top_metrics" x="0" y="55" width="450" height="90">
            <Variant mode="AMBIENT" target="alpha" value="0" />

            <!-- 1. HEART RATE (Left column: x=40, width=110) -->
            <PartImage x="83" y="10" width="24" height="24">
                <Image resource="ic_heart" />
            </PartImage>
            <PartText x="40" y="42" width="110" height="40">
                <Text align="CENTER">
                    <Font family="dseg7_classic_bold" size="26" color="#ffea6962">
                        <Template>%d<Parameter expression="[HEART_RATE]" /></Template>
                    </Font>
                </Text>
            </PartText>

            <!-- 2. STEP COUNT (Center column: x=170, width=110) -->
            <PartImage x="213" y="10" width="24" height="24">
                <Image resource="ic_steps" />
            </PartImage>
            <PartText x="170" y="42" width="110" height="40">
                <Text align="CENTER">
                    <Font family="dseg7_classic_bold" size="26" color="#ff7daea3">
                        <Template>%d<Parameter expression="[STEP_COUNT]" /></Template>
                    </Font>
                </Text>
            </PartText>

            <!-- 3. BATTERY (Right column: x=300, width=110) -->
            <PartImage x="343" y="10" width="24" height="24">
                <Image resource="ic_battery" />
            </PartImage>
            <PartText x="300" y="42" width="110" height="40">
                <Text align="CENTER">
                    <Font family="dseg7_classic_bold" size="26" color="#ffa9b665">
                        <Template>%d%%<Parameter expression="[BATTERY_PERCENT]" /></Template>
                    </Font>
                </Text>
            </PartText>
        </Group>

        <!-- ============================================================ -->
        <!-- CENTER DIGITAL CLOCK AREA                                    -->
        <!-- ============================================================ -->
        <!-- Ghost 88:88 underlay in Gruvbox dark gray (#ff3c3836)        -->
        <PartText x="25" y="160" width="400" height="130">
            <Text align="CENTER">
                <Font family="dseg7_classic_bold" size="92" color="#ff3c3836">
                    <Template>88:88</Template>
                </Font>
            </Text>
        </PartText>

        <!-- Active time display in warm Gruvbox cream (#ffd4be98)        -->
        <DigitalClock x="25" y="160" width="400" height="130">
            <TimeText format="hh:mm" hourFormat="SYNC_TO_DEVICE" align="CENTER" x="0" y="0" width="400" height="130">
                <Font family="dseg7_classic_bold" size="92" color="#ffd4be98" />
            </TimeText>
        </DigitalClock>

        <!-- ============================================================ -->
        <!-- SEPARATOR LINE                                               -->
        <!-- ============================================================ -->
        <PartDraw x="45" y="295" width="360" height="4">
            <Line startX="0" startY="2" endX="360" endY="2">
                <Stroke color="#ffd4be98" thickness="3" cap="ROUND" />
            </Line>
        </PartDraw>

        <!-- ============================================================ -->
        <!-- BOTTOM DATE AREA (14-segment LCD: DAY_OF_WEEK MONTH DAY)     -->
        <!-- ============================================================ -->
        <!-- Ghost underlay for date in Gruvbox dark gray (#ff3c3836)     -->
        <PartText x="25" y="318" width="400" height="50">
            <Text align="CENTER">
                <Font family="dseg14_classic_bold" size="30" color="#ff3c3836">
                    <Template>~~~ ~~~ ~~</Template>
                </Font>
            </Text>
        </PartText>

        <!-- Active date text in warm Gruvbox cream (#ffd4be98)           -->
        <PartText x="25" y="318" width="400" height="50">
            <Text align="CENTER">
                <Font family="dseg14_classic_bold" size="30" color="#ffd4be98">
                    <Template>%s %s %02d<Parameter expression="[DAY_OF_WEEK_S]" /><Parameter expression="[MONTH_S]" /><Parameter expression="[DAY]" /></Template>
                </Font>
            </Text>
        </PartText>

    </Scene>
</WatchFace>
