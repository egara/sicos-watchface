<WatchFace width="450" height="450" clipShape="CIRCLE">
    <Metadata key="CLOCK_TYPE" value="DIGITAL" />
    <Metadata key="PREVIEW_TIME" value="10:09:30" />

    <UserConfigurations>
        <BooleanConfiguration
            id="clean_gruvbox_icons"
            displayName="@string/config_gruvbox_icons_label"
            screenReaderText="@string/config_gruvbox_icons_desc"
            defaultValue="TRUE" />
        <BooleanConfiguration
            id="time_format_24h"
            displayName="@string/config_24hour_label"
            screenReaderText="@string/config_24hour_desc"
            defaultValue="TRUE" />
        <ListConfiguration
            id="display_profile"
            displayName="@string/config_display_profile_label"
            screenReaderText="@string/config_display_profile_desc"
            defaultValue="full">
            <ListOption id="full" displayName="@string/profile_full_label" />
            <ListOption id="time_only" displayName="@string/profile_time_only_label" />
        </ListConfiguration>
    </UserConfigurations>

    <Scene backgroundColor="#ff282828">
        <Variant mode="AMBIENT" target="backgroundColor" value="#ff000000" />

        <!-- ============================================================ -->
        <!-- OUTER CIRCULAR BATTERY GAUGE (10-SEGMENT RING)               -->
        <!-- Center: (225, 225), Diameter: 430px (Radius: 215px)          -->
        <!-- Circumference: ~1350.88px -> Slot: ~135.09px                -->
        <!-- Segment Dash: 123.09px, Gap: 12px                            -->
        <!-- ============================================================ -->
        <Condition>
            <Expressions>
                <Expression name="is_full_profile"><![CDATA[[CONFIGURATION.display_profile] != "time_only"]]></Expression>
            </Expressions>
            <Compare expression="is_full_profile">
                <Group name="circular_battery_gauge" x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <!-- 1. Inactive / Ghost 10-segment track (#ff3c3836) -->
                    <!-- 10 discrete segments: 32.8 deg span, 3.2 deg gap, bilateral symmetry at 12:00 -->
                    <PartDraw x="10" y="10" width="430" height="430">
                        <Arc centerX="215" centerY="215" width="430" height="430" startAngle="1.6" endAngle="34.4" direction="CLOCKWISE">
                            <Stroke color="#ff3c3836" thickness="8" cap="ROUND" />
                        </Arc>
                        <Arc centerX="215" centerY="215" width="430" height="430" startAngle="37.6" endAngle="70.4" direction="CLOCKWISE">
                            <Stroke color="#ff3c3836" thickness="8" cap="ROUND" />
                        </Arc>
                        <Arc centerX="215" centerY="215" width="430" height="430" startAngle="73.6" endAngle="106.4" direction="CLOCKWISE">
                            <Stroke color="#ff3c3836" thickness="8" cap="ROUND" />
                        </Arc>
                        <Arc centerX="215" centerY="215" width="430" height="430" startAngle="109.6" endAngle="142.4" direction="CLOCKWISE">
                            <Stroke color="#ff3c3836" thickness="8" cap="ROUND" />
                        </Arc>
                        <Arc centerX="215" centerY="215" width="430" height="430" startAngle="145.6" endAngle="178.4" direction="CLOCKWISE">
                            <Stroke color="#ff3c3836" thickness="8" cap="ROUND" />
                        </Arc>
                        <Arc centerX="215" centerY="215" width="430" height="430" startAngle="181.6" endAngle="214.4" direction="CLOCKWISE">
                            <Stroke color="#ff3c3836" thickness="8" cap="ROUND" />
                        </Arc>
                        <Arc centerX="215" centerY="215" width="430" height="430" startAngle="217.6" endAngle="250.4" direction="CLOCKWISE">
                            <Stroke color="#ff3c3836" thickness="8" cap="ROUND" />
                        </Arc>
                        <Arc centerX="215" centerY="215" width="430" height="430" startAngle="253.6" endAngle="286.4" direction="CLOCKWISE">
                            <Stroke color="#ff3c3836" thickness="8" cap="ROUND" />
                        </Arc>
                        <Arc centerX="215" centerY="215" width="430" height="430" startAngle="289.6" endAngle="322.4" direction="CLOCKWISE">
                            <Stroke color="#ff3c3836" thickness="8" cap="ROUND" />
                        </Arc>
                        <Arc centerX="215" centerY="215" width="430" height="430" startAngle="325.6" endAngle="358.4" direction="CLOCKWISE">
                            <Stroke color="#ff3c3836" thickness="8" cap="ROUND" />
                        </Arc>
                    </PartDraw>

                    <!-- 2. Active battery progress segments in Gruvbox green (#ffa9b665) -->
                    <!-- Each segment has 32.8 deg span. It activates once entering its 10% range and grows proportionally up to full -->
                    <!-- Segment 1: 0% - 10% (1.6 to 34.4 deg) -->
                    <Condition>
                        <Expressions>
                            <Expression name="seg1"><![CDATA[[BATTERY_PERCENT] > 0]]></Expression>
                        </Expressions>
                        <Compare expression="seg1">
                            <PartDraw x="10" y="10" width="430" height="430">
                                <Arc centerX="215" centerY="215" width="430" height="430" startAngle="1.6" endAngle="34.4" direction="CLOCKWISE">
                                    <Transform target="endAngle" value="1.6 + clamp([BATTERY_PERCENT] / 10.0, 0.05, 1.0) * 32.8" />
                                    <Stroke color="#ffa9b665" thickness="8" cap="ROUND" />
                                </Arc>
                            </PartDraw>
                        </Compare>
                    </Condition>

                    <!-- Segment 2: 10% - 20% (37.6 to 70.4 deg) -->
                    <Condition>
                        <Expressions>
                            <Expression name="seg2"><![CDATA[[BATTERY_PERCENT] > 10]]></Expression>
                        </Expressions>
                        <Compare expression="seg2">
                            <PartDraw x="10" y="10" width="430" height="430">
                                <Arc centerX="215" centerY="215" width="430" height="430" startAngle="37.6" endAngle="70.4" direction="CLOCKWISE">
                                    <Transform target="endAngle" value="37.6 + clamp(([BATTERY_PERCENT] - 10.0) / 10.0, 0.05, 1.0) * 32.8" />
                                    <Stroke color="#ffa9b665" thickness="8" cap="ROUND" />
                                </Arc>
                            </PartDraw>
                        </Compare>
                    </Condition>

                    <!-- Segment 3: 20% - 30% (73.6 to 106.4 deg) -->
                    <Condition>
                        <Expressions>
                            <Expression name="seg3"><![CDATA[[BATTERY_PERCENT] > 20]]></Expression>
                        </Expressions>
                        <Compare expression="seg3">
                            <PartDraw x="10" y="10" width="430" height="430">
                                <Arc centerX="215" centerY="215" width="430" height="430" startAngle="73.6" endAngle="106.4" direction="CLOCKWISE">
                                    <Transform target="endAngle" value="73.6 + clamp(([BATTERY_PERCENT] - 20.0) / 10.0, 0.05, 1.0) * 32.8" />
                                    <Stroke color="#ffa9b665" thickness="8" cap="ROUND" />
                                </Arc>
                            </PartDraw>
                        </Compare>
                    </Condition>

                    <!-- Segment 4: 30% - 40% (109.6 to 142.4 deg) -->
                    <Condition>
                        <Expressions>
                            <Expression name="seg4"><![CDATA[[BATTERY_PERCENT] > 30]]></Expression>
                        </Expressions>
                        <Compare expression="seg4">
                            <PartDraw x="10" y="10" width="430" height="430">
                                <Arc centerX="215" centerY="215" width="430" height="430" startAngle="109.6" endAngle="142.4" direction="CLOCKWISE">
                                    <Transform target="endAngle" value="109.6 + clamp(([BATTERY_PERCENT] - 30.0) / 10.0, 0.05, 1.0) * 32.8" />
                                    <Stroke color="#ffa9b665" thickness="8" cap="ROUND" />
                                </Arc>
                            </PartDraw>
                        </Compare>
                    </Condition>

                    <!-- Segment 5: 40% - 50% (145.6 to 178.4 deg) -->
                    <Condition>
                        <Expressions>
                            <Expression name="seg5"><![CDATA[[BATTERY_PERCENT] > 40]]></Expression>
                        </Expressions>
                        <Compare expression="seg5">
                            <PartDraw x="10" y="10" width="430" height="430">
                                <Arc centerX="215" centerY="215" width="430" height="430" startAngle="145.6" endAngle="178.4" direction="CLOCKWISE">
                                    <Transform target="endAngle" value="145.6 + clamp(([BATTERY_PERCENT] - 40.0) / 10.0, 0.05, 1.0) * 32.8" />
                                    <Stroke color="#ffa9b665" thickness="8" cap="ROUND" />
                                </Arc>
                            </PartDraw>
                        </Compare>
                    </Condition>

                    <!-- Segment 6: 50% - 60% (181.6 to 214.4 deg) -->
                    <Condition>
                        <Expressions>
                            <Expression name="seg6"><![CDATA[[BATTERY_PERCENT] > 50]]></Expression>
                        </Expressions>
                        <Compare expression="seg6">
                            <PartDraw x="10" y="10" width="430" height="430">
                                <Arc centerX="215" centerY="215" width="430" height="430" startAngle="181.6" endAngle="214.4" direction="CLOCKWISE">
                                    <Transform target="endAngle" value="181.6 + clamp(([BATTERY_PERCENT] - 50.0) / 10.0, 0.05, 1.0) * 32.8" />
                                    <Stroke color="#ffa9b665" thickness="8" cap="ROUND" />
                                </Arc>
                            </PartDraw>
                        </Compare>
                    </Condition>

                    <!-- Segment 7: 60% - 70% (217.6 to 250.4 deg) -->
                    <Condition>
                        <Expressions>
                            <Expression name="seg7"><![CDATA[[BATTERY_PERCENT] > 60]]></Expression>
                        </Expressions>
                        <Compare expression="seg7">
                            <PartDraw x="10" y="10" width="430" height="430">
                                <Arc centerX="215" centerY="215" width="430" height="430" startAngle="217.6" endAngle="250.4" direction="CLOCKWISE">
                                    <Transform target="endAngle" value="217.6 + clamp(([BATTERY_PERCENT] - 60.0) / 10.0, 0.05, 1.0) * 32.8" />
                                    <Stroke color="#ffa9b665" thickness="8" cap="ROUND" />
                                </Arc>
                            </PartDraw>
                        </Compare>
                    </Condition>

                    <!-- Segment 8: 70% - 80% (253.6 to 286.4 deg) -->
                    <Condition>
                        <Expressions>
                            <Expression name="seg8"><![CDATA[[BATTERY_PERCENT] > 70]]></Expression>
                        </Expressions>
                        <Compare expression="seg8">
                            <PartDraw x="10" y="10" width="430" height="430">
                                <Arc centerX="215" centerY="215" width="430" height="430" startAngle="253.6" endAngle="286.4" direction="CLOCKWISE">
                                    <Transform target="endAngle" value="253.6 + clamp(([BATTERY_PERCENT] - 70.0) / 10.0, 0.05, 1.0) * 32.8" />
                                    <Stroke color="#ffa9b665" thickness="8" cap="ROUND" />
                                </Arc>
                            </PartDraw>
                        </Compare>
                    </Condition>

                    <!-- Segment 9: 80% - 90% (289.6 to 322.4 deg) -->
                    <Condition>
                        <Expressions>
                            <Expression name="seg9"><![CDATA[[BATTERY_PERCENT] > 80]]></Expression>
                        </Expressions>
                        <Compare expression="seg9">
                            <PartDraw x="10" y="10" width="430" height="430">
                                <Arc centerX="215" centerY="215" width="430" height="430" startAngle="289.6" endAngle="322.4" direction="CLOCKWISE">
                                    <Transform target="endAngle" value="289.6 + clamp(([BATTERY_PERCENT] - 80.0) / 10.0, 0.05, 1.0) * 32.8" />
                                    <Stroke color="#ffa9b665" thickness="8" cap="ROUND" />
                                </Arc>
                            </PartDraw>
                        </Compare>
                    </Condition>

                    <!-- Segment 10: 90% - 100% (325.6 to 358.4 deg) -->
                    <Condition>
                        <Expressions>
                            <Expression name="seg10"><![CDATA[[BATTERY_PERCENT] > 90]]></Expression>
                        </Expressions>
                        <Compare expression="seg10">
                            <PartDraw x="10" y="10" width="430" height="430">
                                <Arc centerX="215" centerY="215" width="430" height="430" startAngle="325.6" endAngle="358.4" direction="CLOCKWISE">
                                    <Transform target="endAngle" value="325.6 + clamp(([BATTERY_PERCENT] - 90.0) / 10.0, 0.05, 1.0) * 32.8" />
                                    <Stroke color="#ffa9b665" thickness="8" cap="ROUND" />
                                </Arc>
                            </PartDraw>
                        </Compare>
                    </Condition>
                </Group>
            </Compare>
        </Condition>

        <!-- ============================================================ -->
        <!-- TOP COMPLICATIONS ROW (3 Centered Columns)                   -->
        <!-- Slot 1: Cardio Load (Left, Gruvbox Red #ffea6962)           -->
        <!-- Slot 2: Steps (Center, Gruvbox Aqua #ff83a598)               -->
        <!-- Slot 3: Temperature (Right, Gruvbox Yellow #ffd8a657)        -->
        <!-- ============================================================ -->

        <!-- 1. CARDIO LOAD / CUSTOMIZABLE (Left: x=78, width=100) -->
        <ComplicationSlot slotId="1" supportedTypes="SHORT_TEXT RANGED_VALUE EMPTY"
            x="78" y="55" width="100" height="90" displayName="@string/complication_cardioload_label" isCustomizable="TRUE">
            <BoundingBox x="0" y="0" width="100" height="90" />
            <DefaultProviderPolicy
                primaryProvider="com.fitbit.FitbitMobile/com.google.android.wearable.fitbit.mainapp.complications.offloadable.cardioload.OffloadableCardioLoadComplicationDataSourceService"
                primaryProviderType="SHORT_TEXT"
                defaultSystemProvider="EMPTY"
                defaultSystemProviderType="EMPTY" />
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Complication type="SHORT_TEXT">
                <Condition>
                    <Expressions>
                        <Expression name="show_dynamic"><![CDATA[[CONFIGURATION.display_profile] != "time_only" && [CONFIGURATION.clean_gruvbox_icons] != "TRUE" && [COMPLICATION.MONOCHROMATIC_IMAGE] != null]]></Expression>
                        <Expression name="show_native"><![CDATA[[CONFIGURATION.display_profile] != "time_only" && ([CONFIGURATION.clean_gruvbox_icons] == "TRUE" || [COMPLICATION.MONOCHROMATIC_IMAGE] == null)]]></Expression>
                    </Expressions>
                    <Compare expression="show_dynamic">
                        <PartImage x="38" y="10" width="24" height="24" tintColor="#ffea6962">
                            <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
                        </PartImage>
                        <PartText x="0" y="42" width="100" height="40">
                            <Text align="CENTER">
                                <Font family="dseg7_classic_bold" size="24" color="#ffea6962">
                                    <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                                </Font>
                            </Text>
                        </PartText>
                    </Compare>
                    <Compare expression="show_native">
                        <PartImage x="38" y="10" width="24" height="24" tintColor="#ffea6962">
                            <Image resource="ic_heart" />
                        </PartImage>
                        <PartText x="0" y="42" width="100" height="40">
                            <Text align="CENTER">
                                <Font family="dseg7_classic_bold" size="24" color="#ffea6962">
                                    <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                                </Font>
                            </Text>
                        </PartText>
                    </Compare>
                </Condition>
            </Complication>
            <Complication type="RANGED_VALUE">
                <Condition>
                    <Expressions>
                        <Expression name="show_dynamic"><![CDATA[[CONFIGURATION.display_profile] != "time_only" && [CONFIGURATION.clean_gruvbox_icons] != "TRUE" && [COMPLICATION.MONOCHROMATIC_IMAGE] != null]]></Expression>
                        <Expression name="show_native"><![CDATA[[CONFIGURATION.display_profile] != "time_only" && ([CONFIGURATION.clean_gruvbox_icons] == "TRUE" || [COMPLICATION.MONOCHROMATIC_IMAGE] == null)]]></Expression>
                    </Expressions>
                    <Compare expression="show_dynamic">
                        <PartImage x="38" y="10" width="24" height="24" tintColor="#ffea6962">
                            <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
                        </PartImage>
                        <PartText x="0" y="42" width="100" height="40">
                            <Text align="CENTER">
                                <Font family="dseg7_classic_bold" size="24" color="#ffea6962">
                                    <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                                </Font>
                            </Text>
                        </PartText>
                    </Compare>
                    <Compare expression="show_native">
                        <PartImage x="38" y="10" width="24" height="24" tintColor="#ffea6962">
                            <Image resource="ic_heart" />
                        </PartImage>
                        <PartText x="0" y="42" width="100" height="40">
                            <Text align="CENTER">
                                <Font family="dseg7_classic_bold" size="24" color="#ffea6962">
                                    <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                                </Font>
                            </Text>
                        </PartText>
                    </Compare>
                </Condition>
            </Complication>
            <Complication type="EMPTY">
                <Condition>
                    <Expressions>
                        <Expression name="is_full_profile"><![CDATA[[CONFIGURATION.display_profile] != "time_only"]]></Expression>
                    </Expressions>
                    <Compare expression="is_full_profile">
                        <PartImage x="38" y="10" width="24" height="24" tintColor="#ffea6962">
                            <Image resource="ic_heart" />
                        </PartImage>
                        <PartText x="0" y="42" width="100" height="40">
                            <Text align="CENTER">
                                <Font family="dseg7_classic_bold" size="24" color="#ffea6962">
                                    <Template>--</Template>
                                </Font>
                            </Text>
                        </PartText>
                    </Compare>
                </Condition>
            </Complication>
        </ComplicationSlot>

        <!-- 2. STEP COUNT / CUSTOMIZABLE (Center: x=175, width=100) -->
        <ComplicationSlot slotId="2" supportedTypes="SHORT_TEXT RANGED_VALUE EMPTY"
            x="175" y="55" width="100" height="90" displayName="@string/complication_steps_label" isCustomizable="TRUE">
            <BoundingBox x="0" y="0" width="100" height="90" />
            <DefaultProviderPolicy
                defaultSystemProvider="STEP_COUNT"
                defaultSystemProviderType="SHORT_TEXT" />
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Complication type="SHORT_TEXT">
                <Condition>
                    <Expressions>
                        <Expression name="show_dynamic"><![CDATA[[CONFIGURATION.display_profile] != "time_only" && [CONFIGURATION.clean_gruvbox_icons] != "TRUE" && [COMPLICATION.MONOCHROMATIC_IMAGE] != null]]></Expression>
                        <Expression name="show_native"><![CDATA[[CONFIGURATION.display_profile] != "time_only" && ([CONFIGURATION.clean_gruvbox_icons] == "TRUE" || [COMPLICATION.MONOCHROMATIC_IMAGE] == null)]]></Expression>
                    </Expressions>
                    <Compare expression="show_dynamic">
                        <PartImage x="38" y="10" width="24" height="24" tintColor="#ff83a598">
                            <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
                        </PartImage>
                        <PartText x="0" y="42" width="100" height="40">
                            <Text align="CENTER">
                                <Font family="dseg7_classic_bold" size="24" color="#ff83a598">
                                    <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                                </Font>
                            </Text>
                        </PartText>
                    </Compare>
                    <Compare expression="show_native">
                        <PartImage x="38" y="10" width="24" height="24" tintColor="#ff83a598">
                            <Image resource="ic_steps" />
                        </PartImage>
                        <PartText x="0" y="42" width="100" height="40">
                            <Text align="CENTER">
                                <Font family="dseg7_classic_bold" size="24" color="#ff83a598">
                                    <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                                </Font>
                            </Text>
                        </PartText>
                    </Compare>
                </Condition>
            </Complication>
            <Complication type="RANGED_VALUE">
                <Condition>
                    <Expressions>
                        <Expression name="show_dynamic"><![CDATA[[CONFIGURATION.display_profile] != "time_only" && [CONFIGURATION.clean_gruvbox_icons] != "TRUE" && [COMPLICATION.MONOCHROMATIC_IMAGE] != null]]></Expression>
                        <Expression name="show_native"><![CDATA[[CONFIGURATION.display_profile] != "time_only" && ([CONFIGURATION.clean_gruvbox_icons] == "TRUE" || [COMPLICATION.MONOCHROMATIC_IMAGE] == null)]]></Expression>
                    </Expressions>
                    <Compare expression="show_dynamic">
                        <PartImage x="38" y="10" width="24" height="24" tintColor="#ff83a598">
                            <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
                        </PartImage>
                        <PartText x="0" y="42" width="100" height="40">
                            <Text align="CENTER">
                                <Font family="dseg7_classic_bold" size="24" color="#ff83a598">
                                    <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                                </Font>
                            </Text>
                        </PartText>
                    </Compare>
                    <Compare expression="show_native">
                        <PartImage x="38" y="10" width="24" height="24" tintColor="#ff83a598">
                            <Image resource="ic_steps" />
                        </PartImage>
                        <PartText x="0" y="42" width="100" height="40">
                            <Text align="CENTER">
                                <Font family="dseg7_classic_bold" size="24" color="#ff83a598">
                                    <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                                </Font>
                            </Text>
                        </PartText>
                    </Compare>
                </Condition>
            </Complication>
            <Complication type="EMPTY">
                <Condition>
                    <Expressions>
                        <Expression name="is_full_profile"><![CDATA[[CONFIGURATION.display_profile] != "time_only"]]></Expression>
                    </Expressions>
                    <Compare expression="is_full_profile">
                        <PartImage x="38" y="10" width="24" height="24" tintColor="#ff83a598">
                            <Image resource="ic_steps" />
                        </PartImage>
                        <PartText x="0" y="42" width="100" height="40">
                            <Text align="CENTER">
                                <Font family="dseg7_classic_bold" size="24" color="#ff83a598">
                                    <Template>--</Template>
                                </Font>
                            </Text>
                        </PartText>
                    </Compare>
                </Condition>
            </Complication>
        </ComplicationSlot>

        <!-- 3. TEMPERATURE (Right: x=272, width=100) -->
        <ComplicationSlot slotId="3" supportedTypes="SHORT_TEXT RANGED_VALUE EMPTY"
            x="272" y="55" width="100" height="90" displayName="@string/complication_temp_label" isCustomizable="TRUE">
            <BoundingBox x="0" y="0" width="100" height="90" />
            <DefaultProviderPolicy
                primaryProvider="com.google.android.apps.weather/com.google.android.wearable.weather.pixel.ui.complications.currentweather.CWComplicationService"
                primaryProviderType="SHORT_TEXT"
                defaultSystemProvider="EMPTY"
                defaultSystemProviderType="EMPTY" />
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Complication type="SHORT_TEXT">
                <Condition>
                    <Expressions>
                        <Expression name="show_dynamic"><![CDATA[[CONFIGURATION.display_profile] != "time_only" && [COMPLICATION.MONOCHROMATIC_IMAGE] != null]]></Expression>
                        <Expression name="show_fallback"><![CDATA[[CONFIGURATION.display_profile] != "time_only" && [COMPLICATION.MONOCHROMATIC_IMAGE] == null]]></Expression>
                    </Expressions>
                    <Compare expression="show_dynamic">
                        <PartImage x="38" y="10" width="24" height="24" tintColor="#ffd8a657">
                            <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
                        </PartImage>
                        <PartText x="0" y="42" width="100" height="40">
                            <Text align="CENTER">
                                <Font family="dseg7_classic_bold" size="24" color="#ffd8a657">
                                    <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                                </Font>
                            </Text>
                        </PartText>
                    </Compare>
                    <Compare expression="show_fallback">
                        <PartImage x="38" y="10" width="24" height="24">
                            <Image resource="ic_temp" />
                        </PartImage>
                        <PartText x="0" y="42" width="100" height="40">
                            <Text align="CENTER">
                                <Font family="dseg7_classic_bold" size="24" color="#ffd8a657">
                                    <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                                </Font>
                            </Text>
                        </PartText>
                    </Compare>
                </Condition>
            </Complication>
            <Complication type="RANGED_VALUE">
                <Condition>
                    <Expressions>
                        <Expression name="show_dynamic"><![CDATA[[CONFIGURATION.display_profile] != "time_only" && [COMPLICATION.MONOCHROMATIC_IMAGE] != null]]></Expression>
                        <Expression name="show_fallback"><![CDATA[[CONFIGURATION.display_profile] != "time_only" && [COMPLICATION.MONOCHROMATIC_IMAGE] == null]]></Expression>
                    </Expressions>
                    <Compare expression="show_dynamic">
                        <PartImage x="38" y="10" width="24" height="24" tintColor="#ffd8a657">
                            <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
                        </PartImage>
                        <PartText x="0" y="42" width="100" height="40">
                            <Text align="CENTER">
                                <Font family="dseg7_classic_bold" size="24" color="#ffd8a657">
                                    <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                                </Font>
                            </Text>
                        </PartText>
                    </Compare>
                    <Compare expression="show_fallback">
                        <PartImage x="38" y="10" width="24" height="24">
                            <Image resource="ic_temp" />
                        </PartImage>
                        <PartText x="0" y="42" width="100" height="40">
                            <Text align="CENTER">
                                <Font family="dseg7_classic_bold" size="24" color="#ffd8a657">
                                    <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                                </Font>
                            </Text>
                        </PartText>
                    </Compare>
                </Condition>
            </Complication>
            <Complication type="EMPTY">
                <Condition>
                    <Expressions>
                        <Expression name="is_full_profile"><![CDATA[[CONFIGURATION.display_profile] != "time_only"]]></Expression>
                    </Expressions>
                    <Compare expression="is_full_profile">
                        <PartImage x="38" y="10" width="24" height="24">
                            <Image resource="ic_temp" />
                        </PartImage>
                        <PartText x="0" y="42" width="100" height="40">
                            <Text align="CENTER">
                                <Font family="dseg7_classic_bold" size="24" color="#ffd8a657">
                                    <Template>--</Template>
                                </Font>
                            </Text>
                        </PartText>
                    </Compare>
                </Condition>
            </Complication>
        </ComplicationSlot>

        <!-- ============================================================ -->
        <!-- ============================================================ -->
        <!-- CENTER DIGITAL CLOCK AREA                                    -->
        <!-- Tap shortcut: Launches Flashlight (com.google.android.clockwork.flashlight/.FlashlightActivity) -->
        <!-- ============================================================ -->
        <!-- Ghost 88:88 underlay in Gruvbox dark gray (#ff3c3836)        -->
        <PartText x="25" y="160" width="400" height="130">
            <Text align="CENTER">
                <Font family="dseg7_classic_bold" size="92" color="#ff3c3836">
                    <Template>88:88</Template>
                </Font>
            </Text>
        </PartText>

        <!-- Active time display in warm Gruvbox cream (#ffd4be98)        -->
        <Group name="clock_touch_target" x="25" y="160" width="400" height="130">
            <Launch target="com.google.android.clockwork.flashlight/com.google.android.clockwork.flashlight.FlashlightActivity" />
            <Condition>
                <Expressions>
                    <Expression name="is_24h"><![CDATA[[CONFIGURATION.time_format_24h] == "TRUE"]]></Expression>
                </Expressions>
                <Compare expression="is_24h">
                    <DigitalClock x="0" y="0" width="400" height="130">
                        <TimeText format="hh:mm" hourFormat="24" align="CENTER" x="0" y="0" width="400" height="130">
                            <Font family="dseg7_classic_bold" size="92" color="#ffd4be98" />
                        </TimeText>
                    </DigitalClock>
                </Compare>
                <Default>
                    <DigitalClock x="0" y="0" width="400" height="130">
                        <TimeText format="hh:mm" hourFormat="12" align="CENTER" x="0" y="0" width="400" height="130">
                            <Font family="dseg7_classic_bold" size="92" color="#ffd4be98" />
                        </TimeText>
                    </DigitalClock>
                </Default>
            </Condition>
        </Group>

        <!-- ============================================================ -->
        <!-- SEPARATOR LINE & BOTTOM DATE AREA                            -->
        <!-- Tap shortcut: Launches Calendar system shortcut              -->
        <!-- ============================================================ -->
        <Condition>
            <Expressions>
                <Expression name="is_full_profile"><![CDATA[[CONFIGURATION.display_profile] != "time_only"]]></Expression>
            </Expressions>
            <Compare expression="is_full_profile">
                <Group name="bottom_date_group" x="0" y="0" width="450" height="450">
                    <PartDraw x="45" y="295" width="360" height="4">
                        <Variant mode="AMBIENT" target="alpha" value="0" />
                        <Line startX="0" startY="2" endX="360" endY="2">
                            <Stroke color="#ffd4be98" thickness="3" cap="ROUND" />
                        </Line>
                    </PartDraw>

                    <!-- Ghost underlay for date in Gruvbox dark gray (#ff3c3836)     -->
                    <PartText x="25" y="318" width="400" height="50">
                        <Variant mode="AMBIENT" target="alpha" value="0" />
                        <Text align="CENTER">
                            <Font family="dseg14_classic_bold" size="30" color="#ff3c3836">
                                <Template>~~~ ~~~ ~~</Template>
                            </Font>
                        </Text>
                    </PartText>

                    <!-- Active date text in warm Gruvbox cream (#ffd4be98)           -->
                    <PartText x="25" y="318" width="400" height="50">
                        <Variant mode="AMBIENT" target="alpha" value="0" />
                        <Launch target="CALENDAR" />
                        <Text align="CENTER">
                            <Font family="dseg14_classic_bold" size="30" color="#ffd4be98">
                                <Template>%s %s %02d<Parameter expression="[DAY_OF_WEEK_S]" /><Parameter expression="[MONTH_S]" /><Parameter expression="[DAY]" /></Template>
                            </Font>
                        </Text>
                    </PartText>
                </Group>
            </Compare>
        </Condition>

    </Scene>
</WatchFace>
