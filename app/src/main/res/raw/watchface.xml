<WatchFace width="450" height="450" clipShape="CIRCLE">
    <Metadata key="CLOCK_TYPE" value="DIGITAL" />
    <Metadata key="PREVIEW_TIME" value="10:09:30" />

    <UserConfigurations>
        <BooleanConfiguration
            id="clean_gruvbox_icons"
            displayName="@string/config_gruvbox_icons_label"
            screenReaderText="@string/config_gruvbox_icons_desc"
            defaultValue="TRUE" />
        <BooleanConfiguration
            id="time_format_24h"
            displayName="@string/config_24hour_label"
            screenReaderText="@string/config_24hour_desc"
            defaultValue="TRUE" />
    </UserConfigurations>

    <Scene backgroundColor="#ff282828">
        <Variant mode="AMBIENT" target="backgroundColor" value="#ff000000" />

        <!-- ============================================================ -->
        <!-- OUTER CIRCULAR BATTERY GAUGE (10-SEGMENT RING)               -->
        <!-- Center: (225, 225), Diameter: 430px (Radius: 215px)          -->
        <!-- Circumference: ~1350.88px -> Slot: ~135.09px                -->
        <!-- Segment Dash: 123.09px, Gap: 12px                            -->
        <!-- ============================================================ -->
        <Group name="circular_battery_gauge" x="0" y="0" width="450" height="450">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <!-- 1. Inactive / Ghost 10-segment track (#ff3c3836) -->
            <PartDraw x="10" y="10" width="430" height="430">
                <Arc centerX="215" centerY="215" width="430" height="430" startAngle="0" endAngle="360" direction="CLOCKWISE">
                    <Stroke color="#ff3c3836" thickness="8" dashIntervals="123.09 12" dashPhase="6" cap="ROUND" />
                </Arc>
            </PartDraw>

            <!-- 2. Active battery progress arc (fills proportionally up to 360 deg) -->
            <PartDraw x="10" y="10" width="430" height="430">
                <Arc centerX="215" centerY="215" width="430" height="430" startAngle="0" endAngle="360" direction="CLOCKWISE">
                    <Transform target="endAngle" value="clamp([BATTERY_PERCENT] * 3.6, 0.1, 360)" />
                    <Stroke color="#ffa9b665" thickness="8" dashIntervals="123.09 12" dashPhase="6" cap="ROUND" />
                </Arc>
            </PartDraw>
        </Group>

        <!-- ============================================================ -->
        <!-- TOP COMPLICATIONS ROW (3 Centered Columns)                   -->
        <!-- Slot 1: Cardio Load (Left, Gruvbox Red #ffea6962)           -->
        <!-- Slot 2: Steps (Center, Gruvbox Aqua #ff83a598)               -->
        <!-- Slot 3: Temperature (Right, Gruvbox Yellow #ffd8a657)        -->
        <!-- ============================================================ -->

        <!-- 1. CARDIO LOAD / CUSTOMIZABLE (Left: x=78, width=100) -->
        <ComplicationSlot slotId="1" supportedTypes="SHORT_TEXT RANGED_VALUE EMPTY"
            x="78" y="55" width="100" height="90" displayName="@string/complication_cardioload_label" isCustomizable="TRUE">
            <BoundingBox x="0" y="0" width="100" height="90" />
            <DefaultProviderPolicy
                primaryProvider="com.fitbit.FitbitMobile/com.google.android.wearable.fitbit.mainapp.complications.offloadable.cardioload.OffloadableCardioLoadComplicationDataSourceService"
                primaryProviderType="SHORT_TEXT"
                defaultSystemProvider="EMPTY"
                defaultSystemProviderType="EMPTY" />
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Complication type="SHORT_TEXT">
                <Condition>
                    <Expressions>
                        <Expression name="show_dynamic_icon"><![CDATA[[CONFIGURATION.clean_gruvbox_icons] != "TRUE" && [COMPLICATION.MONOCHROMATIC_IMAGE] != null]]></Expression>
                    </Expressions>
                    <Compare expression="show_dynamic_icon">
                        <PartImage x="38" y="10" width="24" height="24" tintColor="#ffea6962">
                            <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
                        </PartImage>
                    </Compare>
                    <Default>
                        <PartImage x="38" y="10" width="24" height="24" tintColor="#ffea6962">
                            <Image resource="ic_heart" />
                        </PartImage>
                    </Default>
                </Condition>
                <PartText x="0" y="42" width="100" height="40">
                    <Text align="CENTER">
                        <Font family="dseg7_classic_bold" size="24" color="#ffea6962">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="RANGED_VALUE">
                <Condition>
                    <Expressions>
                        <Expression name="show_dynamic_icon"><![CDATA[[CONFIGURATION.clean_gruvbox_icons] != "TRUE" && [COMPLICATION.MONOCHROMATIC_IMAGE] != null]]></Expression>
                    </Expressions>
                    <Compare expression="show_dynamic_icon">
                        <PartImage x="38" y="10" width="24" height="24" tintColor="#ffea6962">
                            <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
                        </PartImage>
                    </Compare>
                    <Default>
                        <PartImage x="38" y="10" width="24" height="24" tintColor="#ffea6962">
                            <Image resource="ic_heart" />
                        </PartImage>
                    </Default>
                </Condition>
                <PartText x="0" y="42" width="100" height="40">
                    <Text align="CENTER">
                        <Font family="dseg7_classic_bold" size="24" color="#ffea6962">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="EMPTY">
                <PartImage x="38" y="10" width="24" height="24" tintColor="#ffea6962">
                    <Image resource="ic_heart" />
                </PartImage>
                <PartText x="0" y="42" width="100" height="40">
                    <Text align="CENTER">
                        <Font family="dseg7_classic_bold" size="24" color="#ffea6962">
                            <Template>--</Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <!-- 2. STEP COUNT / CUSTOMIZABLE (Center: x=175, width=100) -->
        <ComplicationSlot slotId="2" supportedTypes="SHORT_TEXT RANGED_VALUE EMPTY"
            x="175" y="55" width="100" height="90" displayName="@string/complication_steps_label" isCustomizable="TRUE">
            <BoundingBox x="0" y="0" width="100" height="90" />
            <DefaultProviderPolicy
                defaultSystemProvider="STEP_COUNT"
                defaultSystemProviderType="SHORT_TEXT" />
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Complication type="SHORT_TEXT">
                <Condition>
                    <Expressions>
                        <Expression name="show_dynamic_icon"><![CDATA[[CONFIGURATION.clean_gruvbox_icons] != "TRUE" && [COMPLICATION.MONOCHROMATIC_IMAGE] != null]]></Expression>
                    </Expressions>
                    <Compare expression="show_dynamic_icon">
                        <PartImage x="38" y="10" width="24" height="24" tintColor="#ff83a598">
                            <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
                        </PartImage>
                    </Compare>
                    <Default>
                        <PartImage x="38" y="10" width="24" height="24" tintColor="#ff83a598">
                            <Image resource="ic_steps" />
                        </PartImage>
                    </Default>
                </Condition>
                <PartText x="0" y="42" width="100" height="40">
                    <Text align="CENTER">
                        <Font family="dseg7_classic_bold" size="24" color="#ff83a598">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="RANGED_VALUE">
                <Condition>
                    <Expressions>
                        <Expression name="show_dynamic_icon"><![CDATA[[CONFIGURATION.clean_gruvbox_icons] != "TRUE" && [COMPLICATION.MONOCHROMATIC_IMAGE] != null]]></Expression>
                    </Expressions>
                    <Compare expression="show_dynamic_icon">
                        <PartImage x="38" y="10" width="24" height="24" tintColor="#ff83a598">
                            <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
                        </PartImage>
                    </Compare>
                    <Default>
                        <PartImage x="38" y="10" width="24" height="24" tintColor="#ff83a598">
                            <Image resource="ic_steps" />
                        </PartImage>
                    </Default>
                </Condition>
                <PartText x="0" y="42" width="100" height="40">
                    <Text align="CENTER">
                        <Font family="dseg7_classic_bold" size="24" color="#ff83a598">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="EMPTY">
                <PartImage x="38" y="10" width="24" height="24" tintColor="#ff83a598">
                    <Image resource="ic_steps" />
                </PartImage>
                <PartText x="0" y="42" width="100" height="40">
                    <Text align="CENTER">
                        <Font family="dseg7_classic_bold" size="24" color="#ff83a598">
                            <Template>--</Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <!-- 3. TEMPERATURE (Right: x=272, width=100) -->
        <ComplicationSlot slotId="3" supportedTypes="SHORT_TEXT RANGED_VALUE EMPTY"
            x="272" y="55" width="100" height="90" displayName="@string/complication_temp_label" isCustomizable="TRUE">
            <BoundingBox x="0" y="0" width="100" height="90" />
            <DefaultProviderPolicy
                primaryProvider="com.google.android.apps.weather/com.google.android.wearable.weather.pixel.ui.complications.currentweather.CWComplicationService"
                primaryProviderType="SHORT_TEXT"
                defaultSystemProvider="EMPTY"
                defaultSystemProviderType="EMPTY" />
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Complication type="SHORT_TEXT">
                <Condition>
                    <Expressions>
                        <Expression name="has_weather_icon"><![CDATA[[COMPLICATION.MONOCHROMATIC_IMAGE] != null]]></Expression>
                    </Expressions>
                    <Compare expression="has_weather_icon">
                        <PartImage x="38" y="10" width="24" height="24" tintColor="#ffd8a657">
                            <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
                        </PartImage>
                    </Compare>
                    <Default>
                        <PartImage x="38" y="10" width="24" height="24">
                            <Image resource="ic_temp" />
                        </PartImage>
                    </Default>
                </Condition>
                <PartText x="0" y="42" width="100" height="40">
                    <Text align="CENTER">
                        <Font family="dseg7_classic_bold" size="24" color="#ffd8a657">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="RANGED_VALUE">
                <Condition>
                    <Expressions>
                        <Expression name="has_weather_icon"><![CDATA[[COMPLICATION.MONOCHROMATIC_IMAGE] != null]]></Expression>
                    </Expressions>
                    <Compare expression="has_weather_icon">
                        <PartImage x="38" y="10" width="24" height="24" tintColor="#ffd8a657">
                            <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
                        </PartImage>
                    </Compare>
                    <Default>
                        <PartImage x="38" y="10" width="24" height="24">
                            <Image resource="ic_temp" />
                        </PartImage>
                    </Default>
                </Condition>
                <PartText x="0" y="42" width="100" height="40">
                    <Text align="CENTER">
                        <Font family="dseg7_classic_bold" size="24" color="#ffd8a657">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="EMPTY">
                <PartImage x="38" y="10" width="24" height="24">
                    <Image resource="ic_temp" />
                </PartImage>
                <PartText x="0" y="42" width="100" height="40">
                    <Text align="CENTER">
                        <Font family="dseg7_classic_bold" size="24" color="#ffd8a657">
                            <Template>--</Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <!-- ============================================================ -->
        <!-- ============================================================ -->
        <!-- CENTER DIGITAL CLOCK AREA                                    -->
        <!-- Tap shortcut: Launches Flashlight (com.google.android.clockwork.flashlight/.FlashlightActivity) -->
        <!-- ============================================================ -->
        <!-- Ghost 88:88 underlay in Gruvbox dark gray (#ff3c3836)        -->
        <PartText x="25" y="160" width="400" height="130">
            <Text align="CENTER">
                <Font family="dseg7_classic_bold" size="92" color="#ff3c3836">
                    <Template>88:88</Template>
                </Font>
            </Text>
        </PartText>

        <!-- Active time display in warm Gruvbox cream (#ffd4be98)        -->
        <Group name="clock_touch_target" x="25" y="160" width="400" height="130">
            <Launch target="com.google.android.clockwork.flashlight/com.google.android.clockwork.flashlight.FlashlightActivity" />
            <Condition>
                <Expressions>
                    <Expression name="is_24h"><![CDATA[[CONFIGURATION.time_format_24h] == "TRUE"]]></Expression>
                </Expressions>
                <Compare expression="is_24h">
                    <DigitalClock x="0" y="0" width="400" height="130">
                        <TimeText format="hh:mm" hourFormat="24" align="CENTER" x="0" y="0" width="400" height="130">
                            <Font family="dseg7_classic_bold" size="92" color="#ffd4be98" />
                        </TimeText>
                    </DigitalClock>
                </Compare>
                <Default>
                    <DigitalClock x="0" y="0" width="400" height="130">
                        <TimeText format="hh:mm" hourFormat="12" align="CENTER" x="0" y="0" width="400" height="130">
                            <Font family="dseg7_classic_bold" size="92" color="#ffd4be98" />
                        </TimeText>
                    </DigitalClock>
                </Default>
            </Condition>
        </Group>

        <!-- ============================================================ -->
        <!-- SEPARATOR LINE                                               -->
        <!-- ============================================================ -->
        <PartDraw x="45" y="295" width="360" height="4">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Line startX="0" startY="2" endX="360" endY="2">
                <Stroke color="#ffd4be98" thickness="3" cap="ROUND" />
            </Line>
        </PartDraw>

        <!-- ============================================================ -->
        <!-- BOTTOM DATE AREA (14-segment LCD: DAY_OF_WEEK MONTH DAY)     -->
        <!-- Tap shortcut: Launches Calendar system shortcut              -->
        <!-- ============================================================ -->
        <!-- Ghost underlay for date in Gruvbox dark gray (#ff3c3836)     -->
        <PartText x="25" y="318" width="400" height="50">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Text align="CENTER">
                <Font family="dseg14_classic_bold" size="30" color="#ff3c3836">
                    <Template>~~~ ~~~ ~~</Template>
                </Font>
            </Text>
        </PartText>

        <!-- Active date text in warm Gruvbox cream (#ffd4be98)           -->
        <PartText x="25" y="318" width="400" height="50">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Launch target="CALENDAR" />
            <Text align="CENTER">
                <Font family="dseg14_classic_bold" size="30" color="#ffd4be98">
                    <Template>%s %s %02d<Parameter expression="[DAY_OF_WEEK_S]" /><Parameter expression="[MONTH_S]" /><Parameter expression="[DAY]" /></Template>
                </Font>
            </Text>
        </PartText>

    </Scene>
</WatchFace>
